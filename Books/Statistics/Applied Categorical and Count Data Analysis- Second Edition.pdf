         <pdf:Keywords>Biomedical and psychosocial research; Categorical Data Analysis; clinical trials and observations studies; Contingency Tables; Count Data Analysis; graduate-level biostatistics; logistic models</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>9780367568276</dc:identifier>
         <dc:source>9781003109815</dc:source>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Applied Categorical and Count Data Analysis: Second Edition</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>Wan Tang</rdf:li>
               <rdf:li>Hua He</rdf:li>
               <rdf:li>Xin M. Tu</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This second edition explains how to perform the statistical analysis of discrete data, including categorical and count outcomes. It covers classic concepts and popular topics, such as logistic regression models, along with modern areas including models for zero-modified count outcomes.</rdf:li>
            </rdf:Alt>
         </dc:description>
